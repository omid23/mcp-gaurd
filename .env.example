# Copy to .env and fill in. Never commit .env.

# openssl rand -hex 32; must be identical on every replica
MCPGUARD_STATE_SECRET=
# heuristic | jev | llm | vertex | classifier (read by config/demo.yaml)
MCPGUARD_BACKEND=heuristic
# for the jev backend
TYPESAFE_API_KEY=
# for the llm judge backend
OPENAI_API_KEY=
# for the vertex backend: an express-mode API key, or leave empty and use
# Application Default Credentials (gcloud auth application-default login)
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
# key1:alice,key2:ci-bot when auth.mode is api_key
MCPGUARD_API_KEYS=
# e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
